{
  "gopls": {
    "command": "${CLAUDE_PLUGIN_ROOT}/bin/project-lsp",
    "args": ["--", "gopls"],
    "extensionToLanguage": {
      ".go": "go"
    }
  },
  "pyright": {
    "command": "${CLAUDE_PLUGIN_ROOT}/bin/project-lsp",
    "args": ["--", "pyright-langserver", "--stdio"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  },
  "rust-analyzer": {
    "command": "${CLAUDE_PLUGIN_ROOT}/bin/project-lsp",
    "args": ["--", "rust-analyzer"],
    "extensionToLanguage": {
      ".rs": "rust"
    }
  },
  "typescript": {
    "command": "${CLAUDE_PLUGIN_ROOT}/bin/project-lsp",
    "args": ["--", "${CLAUDE_PLUGIN_ROOT}/bin/typescript-server"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  }
}
